%
% Title page. The positions follow the title slides of the official PowerPoint templates A to D.
%
\newcommand{\scitokyo@titlepage@A}{%
  \scitokyo@background{title-A}{0}{\scitokyo@draw@title@A}%
  \scitokyo@logoat{wide}{0.740}{0.704}{0.232}%
  \scitokyo@titleblock{white}{south west}{0.0995}{0.373}{0.845}{0.845}%
  \scitokyo@dateblock{white}{east}{0.972}{0.965}{0.46}%
}
\newcommand{\scitokyo@titlepage@B}{%
  \scitokyo@background{title-B}{0}{\scitokyo@draw@title@B}%
  \scitokyo@logoat{wide}{0.047}{0.852}{0.197}%
  \scitokyo@titleblock{}{south west}{0.0465}{0.527}{0.77}{0.62}%
  \scitokyo@dateblock{white}{east}{0.972}{0.9375}{0.46}%
}
\newcommand{\scitokyo@titlepage@C}{%
  \scitokyo@background{title-C}{0.023}{\scitokyo@draw@title@C}%
  \scitokyo@logoat{wide}{0.047}{0.801}{0.197}%
  \scitokyo@titleblock{}{north west}{0.0455}{0.046}{0.67}{0.40}%
  \scitokyo@dateblock{}{north east}{0.9535}{0.045}{0.23}%
}
\newcommand{\scitokyo@titlepage@D}{%
  \scitokyo@background{title-D}{0}{\scitokyo@draw@title@D}%
  \scitokyo@logoat{wide}{0.776}{0.122}{0.197}%
  \scitokyo@titleblock{}{south west}{0.0475}{0.730}{0.85}{0.68}%
  \scitokyo@dateblock{}{north east}{0.973}{0.225}{0.36}%
}
\setbeamertemplate{title page}{%
  \begin{scitokyo@pagescope}
    \scitokyo@cover
    \csuse{scitokyo@titlepage@\scitokyo@variant}
  \end{scitokyo@pagescope}%
}
\def\maketitle{%
  \ifbeamer@inframe
  \titlepage
  \else
  \frame[plain,noframenumbering]{\titlepage}
  \fi
}
\def\titlepage{%
  \usebeamertemplate{title page}
}
\setbeamertemplate{title}{\inserttitle\par}
\setbeamertemplate{subtitle}{\insertsubtitle\par}
\setbeamertemplate{author}{\insertauthor\par}
\setbeamertemplate{institute}{\insertinstitute\par}
\setbeamertemplate{date}{\insertdate\par}
%
% Section page. #1: strong or pale, #2: heading.
%
% #1: anchor, #2: alignment, #3 and #4: position of the anchor, #5: width.
\newcommand{\scitokyo@sectiontitle}[5]{%
  \node[anchor=#1, inner sep=0pt, text width=#5\paperwidth, align=#2] at (#3,#4) {%
    \usebeamercolor[fg]{section title}\usebeamerfont{section title}\scitokyo@heading\par
  };
}
\newcommand{\scitokyo@sectionpage@A}[1]{%
  \scitokyo@background{section-#1-A}{0}{\scitokyo@draw@section@A{#1}}%
  \scitokyo@sectiontitle{west}{left}{0.0545}{0.502}{0.88}%
}
\newcommand{\scitokyo@sectionpage@B}[1]{%
  \scitokyo@background{section-#1-B}{0}{\scitokyo@draw@section@B{#1}}%
  \scitokyo@sectiontitle{west}{left}{0.0445}{0.218}{0.88}%
}
\newcommand{\scitokyo@sectionpage@C}[1]{%
  \scitokyo@background{section-#1-C}{0.048}{\scitokyo@draw@section@C{#1}}%
  \scitokyo@sectiontitle{west}{left}{0.0475}{0.718}{0.445}%
}
\newcommand{\scitokyo@sectionpage@D}[1]{%
  \scitokyo@background{section-#1-D}{0}{\scitokyo@draw@section@D{#1}}%
  \scitokyo@sectiontitle{center}{center}{0.495}{0.426}{0.88}%
}
\newcommand{\scitokyo@sectionpage}[2]{%
  \def\scitokyo@heading{#2}%
  \begin{scitokyo@pagescope}
    \scitokyo@cover
    \csuse{scitokyo@sectionpage@\scitokyo@variant}{#1}%
    \scitokyo@logoat{wide}{0.795}{0.032}{0.177}%
  \end{scitokyo@pagescope}%
}
\setbeamertemplate{section page}{\scitokyo@sectionpage{\scitokyo@sectionstyle}{\insertsectionhead}}
\setbeamertemplate{subsection page}{\scitokyo@sectionpage{\scitokyo@subsectionstyle}{\insertsubsectionhead}}
\newcommand{\scitokyo@disablesectionpage}{
  \AtBeginSection{
    % intentionally empty
  }
}
\newcommand{\scitokyo@enablesectionpage}{
  \AtBeginSection{
    \ifbeamer@inframe
    \sectionpage
    \else
    \frame[plain,c,noframenumbering]{\sectionpage}
    \fi
  }
}
\newcommand{\scitokyo@disablesubsectionpage}{
  \AtBeginSubsection{
    % intentionally empty
  }
}
\newcommand{\scitokyo@enablesubsectionpage}{
  \AtBeginSubsection{
    \ifbeamer@inframe
    \subsectionpage
    \else
    \frame[plain,c,noframenumbering]{\subsectionpage}
    \fi
  }
}
%
% Table of contents, numbered like the official outline slide.
%
\setbeamertemplate{section in toc}[sections numbered]
\def\inserttotalframenumber{100}
%
% Blocks
%
\newlength{\scitokyo@blocksep}
\newlength{\scitokyo@blockadjust}
\setlength{\scitokyo@blocksep}{0.75ex}
\setlength{\scitokyo@blockadjust}{0.25ex}
\providecommand{\scitokyo@strut}{%
  \vphantom{ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz()}%
}
\newcommand{\scitokyo@block}[1]{
  \par\vskip\medskipamount%
  \setlength{\parskip}{0pt}
  \ifbeamercolorempty[bg]{block title#1}{%
    \begin{beamercolorbox}[rightskip=0pt plus 4em]{block title#1}}{%
    \ifbeamercolorempty[bg]{block title}{%
      \begin{beamercolorbox}[rightskip=0pt plus 4em]{block title#1}%
    }%
    {%
      \begin{beamercolorbox}[
        sep=\dimexpr\scitokyo@blocksep-\scitokyo@blockadjust\relax,
        leftskip=\scitokyo@blockadjust,
        rightskip=\dimexpr\scitokyo@blockadjust plus 4em\relax
        ]{block title#1}%
    }}%
  \usebeamerfont*{block title#1}%
  \scitokyo@strut%
  \insertblocktitle%
  \scitokyo@strut%
  \end{beamercolorbox}%
  \nointerlineskip%
  \ifbeamercolorempty[bg]{block body#1}{%
    \begin{beamercolorbox}[vmode]{block body#1}}{
    \ifbeamercolorempty[bg]{block body}{%
      \begin{beamercolorbox}[vmode]{block body#1}%
    }{%
      \begin{beamercolorbox}[sep=\scitokyo@blocksep, vmode]{block body#1}%
      \vspace{-\scitokyo@parskip}
    }}%
  \usebeamerfont{block body#1}%
  \setlength{\parskip}{\scitokyo@parskip}%
}
\setbeamertemplate{block begin}{\scitokyo@block{}}
\setbeamertemplate{block alerted begin}{\scitokyo@block{ alerted}}
\setbeamertemplate{block example begin}{\scitokyo@block{ example}}
\setbeamertemplate{block end}{\end{beamercolorbox}\vspace*{0.2ex}}
\setbeamertemplate{block alerted end}{\end{beamercolorbox}\vspace*{0.2ex}}
\setbeamertemplate{block example end}{\end{beamercolorbox}\vspace*{0.2ex}}
%
% Lists, captions, footnotes and spacing
%
\setbeamertemplate{itemize items}{\textbullet}
\setbeamertemplate{caption label separator}{: }
\setbeamertemplate{caption}[numbered]
\setbeamertemplate{footnote}{%
  \parindent 0em\noindent%
  \raggedright
  \usebeamercolor{footnote}\hbox to 0.8em{\hfil\insertfootnotemark}\insertfootnotetext\par%
}
\newlength{\scitokyo@parskip}
\setlength{\scitokyo@parskip}{0.5em}
\setlength{\parskip}{\scitokyo@parskip}
\linespread{1.15}
\define@key{beamerframe}{c}[true]{% centered
  \beamer@frametopskip=0pt plus 1fill\relax%
  \beamer@framebottomskip=0pt plus 1fill\relax%
  \beamer@frametopskipautobreak=0pt plus .4\paperheight\relax%
  \beamer@framebottomskipautobreak=0pt plus .6\paperheight\relax%
  \def\beamer@initfirstlineunskip{}%
}
%
% Standout frames: [standout] gives a navy page with centered text.
%
\providebool{scitokyo@standout}
\define@key{beamerframe}{standout}[true]{%
  \booltrue{scitokyo@standout}
  \begingroup
  \setkeys{beamerframe}{c}
