\@ifundefined{ifscitokyo@img}{\newif\ifscitokyo@img\scitokyo@imgtrue}{}
\pgfkeys{
  /sciencetokyo/inner/variant/.cd,
  .is choice,
  A/.code=\def\scitokyo@variant{A},
  B/.code=\def\scitokyo@variant{B},
  C/.code=\def\scitokyo@variant{C},
  D/.code=\def\scitokyo@variant{D},
}
\pgfkeys{
  /sciencetokyo/inner/sectionpage/.cd,
  .is choice,
  none/.code=\scitokyo@disablesectionpage,
  strong/.code={\def\scitokyo@sectionstyle{strong}\scitokyo@enablesectionpage},
  pale/.code={\def\scitokyo@sectionstyle{pale}\scitokyo@enablesectionpage},
}
\pgfkeys{
  /sciencetokyo/inner/subsectionpage/.cd,
  .is choice,
  none/.code=\scitokyo@disablesubsectionpage,
  strong/.code={\def\scitokyo@subsectionstyle{strong}\scitokyo@enablesubsectionpage},
  pale/.code={\def\scitokyo@subsectionstyle{pale}\scitokyo@enablesubsectionpage},
}
\newcommand{\scitokyo@inner@setdefaults}{
  \pgfkeys{/sciencetokyo/inner/.cd,
    variant=A,
    sectionpage=strong,
    subsectionpage=none,
  }
}
\def\scitokyo@sectionstyle{strong}
\def\scitokyo@subsectionstyle{strong}
%
% Images. Each official image is looked up as sciencetokyo-<name>.png or .jpg on the TeX search path, then in img/ under the current directory, which is where Overleaf keeps it.
%
\newcommand{\scitokyo@findimage}[1]{%
  \let\scitokyo@imagefile\@empty
  \@for\scitokyo@candidate:={sciencetokyo-#1.png,sciencetokyo-#1.jpg,img/sciencetokyo-#1.png,img/sciencetokyo-#1.jpg}\do{%
    \ifx\scitokyo@imagefile\@empty
      \IfFileExists{\scitokyo@candidate}{\let\scitokyo@imagefile\scitokyo@candidate}{}%
    \fi
  }%
}
\newcommand{\scitokyo@ifimage}[3]{%
  \ifscitokyo@img
    \scitokyo@findimage{#1}%
  \else
    \let\scitokyo@imagefile\@empty
  \fi
  \ifx\scitokyo@imagefile\@empty
    \expandafter\@secondoftwo
  \else
    \expandafter\@firstoftwo
  \fi
  {#2}{#3}%
}
% #1: wide or stacked, #2: width.
\newcommand{\scitokyo@logo}[2]{%
  \scitokyo@ifimage{logo-#1}{\includegraphics[width=#2]{\scitokyo@imagefile}}{\scitokyo@textlogo{#1}{#2}}%
}
\newcommand{\scitokyo@textlogo}[2]{%
  \resizebox{#2}{!}{%
    \usebeamercolor[fg]{logo}%
    \vbox{\offinterlineskip
      \hbox{\fontsize{5}{5}\selectfont Institute of}\kern1.5pt
      \ifstrequal{#1}{stacked}{%
        \hbox{\fontsize{10}{10}\selectfont\bfseries SCIENCE}\kern2pt
        \hbox{\fontsize{10}{10}\selectfont\bfseries TOKYO}%
      }{%
        \hbox{\fontsize{10}{10}\selectfont\bfseries SCIENCE TOKYO}%
      }%
    }%
  }%
}
%
% Page drawings. They run inside \scitokyo@pagescope, where (0,0) is the top-left corner of the page, (1,1) is the bottom-right corner, and y grows downward.
%
\newenvironment{scitokyo@pagescope}{%
  \begin{tikzpicture}[remember picture, overlay]
  \begin{scope}[shift={(current page.north west)}, x=\paperwidth, y=-\paperheight]
}{%
  \end{scope}
  \end{tikzpicture}%
}
% Paints the page white, which also hides the headline decorations on title and section pages.
\newcommand{\scitokyo@cover}{\fill[white] (-0.01,-0.01) rectangle (1.01,1.01);}
% #1: image name, #2: left edge of the image, #3: vector fallback.
\newcommand{\scitokyo@background}[3]{%
  \scitokyo@ifimage{#1}{%
    \node[anchor=north west, inner sep=0pt] at (#2,0) {\includegraphics[width=\dimexpr\paperwidth-#2\paperwidth\relax, height=\paperheight]{\scitokyo@imagefile}};%
  }{#3}%
}
% #1: wide or stacked, #2 and #3: top-left corner, #4: width as a fraction of \paperwidth.
\newcommand{\scitokyo@logoat}[4]{%
  \node[anchor=north west, inner sep=0pt] at (#2,#3) {\scitokyo@logo{#1}{#4\paperwidth}};%
}
% Sets the text color of the title page; an empty argument keeps the beamer colors.
\newcommand{\scitokyo@titlecolor}[1]{%
  \ifblank{#1}{}{%
    \setbeamercolor{title}{fg=#1}%
    \setbeamercolor{subtitle}{fg=#1}%
    \setbeamercolor{author}{fg=#1}%
    \setbeamercolor{institute}{fg=#1}%
    \setbeamercolor{date}{fg=#1}%
  }%
}
% Title and subtitle, with author and institute below them.
% #1: text color, #2: anchor of the title, #3 and #4: position of the anchor, #5: title width, #6: author width.
\newcommand{\scitokyo@titleblock}[6]{%
  \node[anchor=#2, inner sep=0pt, text width=#5\paperwidth, align=left] (scitokyo-title) at (#3,#4) {%
    \scitokyo@titlecolor{#1}%
    \usebeamertemplate*{title}%
    \ifx\insertsubtitle\@empty\else\vskip0.4em\usebeamertemplate*{subtitle}\fi
  };
  \node[anchor=north west, inner sep=0pt, text width=#6\paperwidth, align=left, yshift=-0.045\paperheight] at (scitokyo-title.south west) {%
    \scitokyo@titlecolor{#1}%
    \ifx\beamer@shortauthor\@empty\else\usebeamertemplate*{author}\fi
    \ifx\insertinstitute\@empty\else\vskip0.6em\usebeamertemplate*{institute}\fi
  };
}
% Event name and date, set flush right. #1: text color, #2: anchor, #3 and #4: position of the anchor, #5: width.
\newcommand{\scitokyo@dateblock}[5]{%
  \node[anchor=#2, inner sep=0pt, text width=#5\paperwidth, align=right] at (#3,#4) {%
    \scitokyo@titlecolor{#1}%
    \usebeamertemplate*{date}%
  };
}
% Colors of the vector fallback. #1: strong or pale.
\newcommand{\scitokyo@palette}[1]{%
  \expandafter\ifstrequal\expandafter{#1}{pale}{%
    \colorlet{scitokyo@dark}{STnavy!12}%
    \colorlet{scitokyo@light}{STlightblue!10}%
  }{%
    \colorlet{scitokyo@dark}{STnavy}%
    \colorlet{scitokyo@light}{STlightblue}%
  }%
}
